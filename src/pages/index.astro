---
import Base from '../layouts/Base.astro';
import {getEntries,clean,imageOf} from '../lib/content';
const projects=(await getEntries('projects')).slice(0,2);
const placeholder=['https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1200&q=85','https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=85'];
---
<Base><section class="hero"><div class="hero-image"></div><div class="container hero-content"><span class="eyebrow accent">ENGINEERING A BETTER TOMORROW / 001</span><h1>Progress is<br/>built on <em>purpose.</em></h1><div class="hero-lead"><p>We bring clarity to complex energy challenges through engineering expertise, trusted partnerships, and a relentless focus on what comes next.</p><a class="btn" href="/about">Discover our story <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section section-light"><div class="container"><div class="intro-grid"><div><span class="eyebrow">01 / WHO WE ARE</span><h2>Grounded in expertise.<br/>Focused on impact.</h2></div><div><p>From early-stage strategy to on-the-ground execution, we connect the people, capabilities, and thinking that move ambitious energy projects forward.</p><a class="btn btn-dark" href="/about">More about us <span aria-hidden="true">↗</span></a></div></div><div class="stats"><div class="stat"><strong>01</strong><span>Integrated approach</span></div><div class="stat"><strong>03</strong><span>Core service pillars</span></div><div class="stat"><strong>∞</strong><span>Possibilities ahead</span></div></div></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><div><span class="eyebrow accent">02 / OUR EXPERTISE</span><h2>Capability that<br/>moves industries.</h2></div><p>Practical solutions shaped around the demands of today's industrial and energy landscape.</p></div><div class="service-grid"><a class="service-card" href="/services"><span class="service-number">01 / ENGINEERING</span><div><h3>Engineering &<br/>Technical Services</h3><p>Integrated technical thinking from concept through execution.</p></div><span class="arrow" aria-hidden="true">↗</span></a><a class="service-card" href="/services"><span class="service-number">02 / OPERATIONS</span><div><h3>Asset Integrity &<br/>Operations</h3><p>Smarter approaches to reliability, performance, and resilience.</p></div><span class="arrow" aria-hidden="true">↗</span></a><a class="service-card" href="/services"><span class="service-number">03 / DELIVERY</span><div><h3>Project &<br/>Industrial Solutions</h3><p>Connecting expertise and execution for complex environments.</p></div><span class="arrow" aria-hidden="true">↗</span></a></div></div></section>
<section class="section section-white"><div class="container"><div class="section-heading"><div><span class="eyebrow">03 / SELECTED WORK</span><h2>Where ambition<br/>meets execution.</h2></div><a class="btn btn-dark" href="/projects">Explore projects <span aria-hidden="true">↗</span></a></div><div class="project-grid">{projects.length ? projects.map((p,i)=><a class="project-card" href={`/projects/${p.slug}/`}><div class="project-photo" style={`background-image:url("${imageOf(p)||placeholder[i%2]}")`}></div><div class="project-info"><span>PROJECT / {String(i+1).padStart(2,'0')}</span><h3>{clean(p.title.rendered)}</h3></div></a>) : <><a class="project-card" href="/projects"><div class="project-photo" style={`background-image:url("${placeholder[0]}")`}></div><div class="project-info"><span>CONCEPT / ENGINEERING</span><h3>Engineering for critical infrastructure</h3></div></a><a class="project-card" href="/projects"><div class="project-photo" style={`background-image:url("${placeholder[1]}")`}></div><div class="project-info"><span>CONCEPT / INDUSTRIAL</span><h3>Smarter industrial operations</h3></div></a></>}</div></div></section>
<section class="section section-light"><div class="container"><div class="cta-panel"><div><span class="eyebrow">THE NEXT CHAPTER</span><h2>Let's build what<br/>comes next.</h2></div><a class="btn btn-dark" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a></div></div></section></Base>
