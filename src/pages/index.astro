---
import Base from '../layouts/Base.astro';
import {getEntries,clean,imageOf,formatEventDate} from '../lib/content';
import ProjectCard from '../components/ProjectCard.astro';
const projects=(await getEntries('projects')).slice(0,2);
const events=(await getEntries('events')).slice(0,2);
---
<Base><section class="hero"><div class="hero-image"></div><div class="container hero-content"><span class="eyebrow accent">ENGINEERING A BETTER TOMORROW / 001</span><h1>Progress is<br/>built on <em>purpose.</em></h1><div class="hero-lead"><p>We bring clarity to complex energy challenges through engineering expertise, trusted partnerships, and a relentless focus on what comes next.</p><a class="btn" href="/about">Discover our story <span aria-hidden="true">↗</span></a></div><div class="hero-index" aria-hidden="true"><span>FIELD NOTES / N° 001</span><span class="hero-index-line"></span><span>ENGINEERING IN MOTION</span></div></div></section>
<section class="section section-light"><div class="container"><div class="intro-grid"><div><span class="eyebrow">01 / WHO WE ARE</span><h2>Grounded in expertise.<br/>Focused on impact.</h2></div><div><p>From early-stage strategy to on-the-ground execution, we connect the people, capabilities, and thinking that move ambitious energy projects forward.</p><a class="btn btn-dark" href="/about">More about us <span aria-hidden="true">↗</span></a></div></div><div class="stats" aria-label="Our approach"><div class="stat"><strong>01</strong><span>Understand the challenge</span></div><div class="stat"><strong>02</strong><span>Engineer the solution</span></div><div class="stat"><strong>03</strong><span>Deliver with purpose</span></div></div></div></section>
<section class="visual-story" aria-label="Industrial photography"><div class="container"><figure class="visual-story-figure"><img src="/images/industrial-plant.jpg" width="1600" height="1067" alt="Industrial refinery infrastructure and processing towers, illustrative photography" loading="lazy" decoding="async"/><figcaption><span class="eyebrow accent">FIELD STUDY / 01</span><strong>Perspective changes<br/>everything.</strong><span class="visual-caption-note">INDUSTRIAL INFRASTRUCTURE · EDITORIAL IMAGE</span></figcaption></figure></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><div><span class="eyebrow accent">02 / OUR EXPERTISE</span><h2>Capability that<br/>moves industries.</h2></div><p>Practical solutions shaped around the demands of today's industrial and energy landscape.</p></div><div class="service-grid"><a class="service-card" href="/services"><span class="service-number">01 / ENGINEERING</span><div><h3>Engineering &<br/>Technical Services</h3><p>Integrated technical thinking from concept through execution.</p></div><span class="arrow" aria-hidden="true">↗</span></a><a class="service-card" href="/services"><span class="service-number">02 / OPERATIONS</span><div><h3>Asset Integrity &<br/>Operations</h3><p>Smarter approaches to reliability, performance, and resilience.</p></div><span class="arrow" aria-hidden="true">↗</span></a><a class="service-card" href="/services"><span class="service-number">03 / DELIVERY</span><div><h3>Project &<br/>Industrial Solutions</h3><p>Connecting expertise and execution for complex environments.</p></div><span class="arrow" aria-hidden="true">↗</span></a></div></div></section>
<section class="section section-white"><div class="container"><div class="section-heading"><div><span class="eyebrow">03 / SELECTED WORK</span><h2>Where ambition<br/>meets execution.</h2></div><a class="btn btn-dark" href="/projects">Explore projects <span aria-hidden="true">↗</span></a></div><div class="project-grid">{projects.length ? projects.map((entry,i)=><ProjectCard entry={entry} index={i}/>) : <><ProjectCard fallbackTitle="Engineering for critical infrastructure" fallbackImage="/images/offshore-project.jpg" label="CONCEPT / ENGINEERING"/><ProjectCard fallbackTitle="Smarter industrial operations" fallbackImage="/images/industrial-plant.jpg" label="CONCEPT / INDUSTRIAL"/></>}</div></div></section>
{events.length > 0 && <section class="section section-light"><div class="container"><div class="section-heading"><div><span class="eyebrow">04 / LATEST STORIES</span><h2>Stay in the<br/>conversation.</h2></div><a class="btn btn-dark" href="/events">All updates <span aria-hidden="true">↗</span></a></div><div class="event-grid">{events.map(e=><a class="event-card" href={`/events/${e.slug}/`}><img class="event-photo" src={imageOf(e) || "/images/conference.jpg"} data-fallback={imageOf(e) ? "/images/conference.jpg" : undefined} data-fallback-alt="Illustrative photograph of an energy industry conference" alt={imageOf(e) ? (e._embedded?.['wp:featuredmedia']?.[0]?.alt_text || clean(e.title.rendered)) : "Illustrative photograph of a professional conference audience"} loading="lazy" decoding="async"/><div class="event-card-content"><span class="eyebrow accent">{formatEventDate(e.acf?.event_date || e.date)}</span><h3>{clean(e.title.rendered)}</h3><p>{clean(e.excerpt?.rendered || '')}</p><span class="event-read">Read event <span aria-hidden="true">↗</span></span></div></a>)}</div></div></section>}
<section class="section section-light"><div class="container"><div class="cta-panel"><div><span class="eyebrow">THE NEXT CHAPTER</span><h2>Let's build what<br/>comes next.</h2></div><a class="btn btn-dark" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a></div></div></section></Base>
