---
import Base from '../../layouts/Base.astro';
import {getEntries,clean,imageOf,galleryOf} from '../../lib/content';
export async function getStaticPaths() {
  const entries=await getEntries('projects');
  return entries.map(entry=>({params:{slug:entry.slug},props:{entry}}));
}
const {entry}=Astro.props;
const details=[
  ...(entry.acf?.project_location ? [['Location',entry.acf.project_location]] : []),
  ...(entry.acf?.project_year ? [['Year',String(entry.acf.project_year)]] : []),
  ...(entry.acf?.client_name ? [['Client',entry.acf.client_name]] : []),
  ...(entry.acf?.project_status ? [['Status',entry.acf.project_status]] : [])
];
---
<Base title={`${clean(entry.title.rendered)} | NEXORA Energy`}>
  <section class="page-hero"><div class="container"><a class="back-link" href="/projects">← All projects</a><span class="eyebrow accent">PROJECT SPOTLIGHT</span><h1>{clean(entry.title.rendered)}</h1><p>{clean(entry.excerpt?.rendered || '')}</p></div></section>
  <section class="section section-white"><div class="container">
    <figure class="article-figure"><img class="article-image" src={imageOf(entry) || "/images/offshore-project.jpg"} data-fallback={imageOf(entry) ? "/images/offshore-project.jpg" : undefined} data-fallback-alt="Illustrative photograph of an offshore oil platform" alt={imageOf(entry) ? (entry._embedded?.['wp:featuredmedia']?.[0]?.alt_text || clean(entry.title.rendered)) : "Illustrative offshore energy platform photo"} width="1600" height="1050" fetchpriority="high"/>{!imageOf(entry) && <figcaption>Illustrative project photography · Portfolio concept</figcaption>}</figure>
    <div class="article-layout"><aside class="article-aside"><span class="eyebrow">PROJECT DETAILS</span><dl class="detail-list">{details.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></aside><article class="body-copy" set:html={entry.content?.rendered || entry.excerpt?.rendered || ''}></article></div>
    {galleryOf(entry).length > 0 && <div class="gallery-grid">{galleryOf(entry).map(img=><img src={img.url} alt={img.alt} loading="lazy"/>)}</div>}
  </div></section>
</Base>
