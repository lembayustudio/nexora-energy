---
import Base from '../../layouts/Base.astro';
import {getEntries,clean,imageOf} from '../../lib/content';
const projects=await getEntries('projects');
---
<Base title="Projects | NEXORA Energy"><section class="page-hero"><div class="container"><span class="eyebrow accent">OUR WORK</span><h1>Work that speaks<br/>for itself.</h1><p>A look at the challenges, thinking, and partnerships behind our projects.</p></div></section><section class="section section-white"><div class="container">{projects.length ? <div class="project-grid">{projects.map((p,i)=><a class="project-card" href={`/projects/${p.slug}/`}><div class="project-photo" style={`background-image:url("${imageOf(p)||'/images/offshore-project.jpg'}")`}></div><div class="project-info"><span>PROJECT / {String(i+1).padStart(2,'0')}</span><h3>{clean(p.title.rendered)}</h3></div></a>)}</div> : <div class="empty-state">Projects will appear here when published in WordPress and the site is rebuilt.</div>}</div></section></Base>
