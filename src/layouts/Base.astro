---
import '../styles/global.css';
const {title='NEXORA Energy | Engineering What Comes Next',description='Integrated energy engineering, industrial services and project delivery.'} = Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Home'],['/about','About'],['/services','Expertise'],['/projects','Projects'],['/events','Events'],['/contact','Contact']];
const isActive=(href:string)=>href==='/'?path==='/':path===href||path.startsWith(href+'/');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101a1c"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="Nexora Energy home"><span class="brand-mark">N<span class="brand-dot">.</span></span><span class="brand-name">NEXORA <small>ENERGY</small></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([href,label])=><a href={href} aria-current={isActive(href)?'page':undefined}>{label}</a>)}</nav><a class="header-cta" href="/contact">Let's talk <span aria-hidden="true">↗</span></a><details class="mobile-menu"><summary aria-label="Toggle navigation">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{nav.map(([href,label])=><a href={href} aria-current={isActive(href)?'page':undefined}>{label}</a>)}</nav></details></div></header>
<main id="main"><slot/></main><footer class="site-footer"><div class="container"><div class="footer-top"><div><a class="brand footer-brand" href="/"><span class="brand-mark">N<span class="brand-dot">.</span></span><span class="brand-name">NEXORA <small>ENERGY</small></span></a><p>Built for complexity.<br/>Driven by possibility.</p></div><div><span class="eyebrow">EXPLORE</span><a href="/about">Our company</a><a href="/services">What we do</a><a href="/projects">Our work</a></div><div><span class="eyebrow">CONNECT</span><a href="/contact">Start a conversation ↗</a><a href="/events">Latest updates</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} NEXORA Energy. Concept project by Lembayu Studio.</span><span>Independent portfolio concept · Not a real company</span></div></div></footer></body></html>
